# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgresql://orbix:orbix@localhost:5433/orbix
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ORBIX_ENCRYPTION_KEY=
ORBIX_API_PORT=4000
ORBIX_WEB_URL=http://localhost:3000
ORBIX_API_PUBLIC_URL=http://localhost:4000
# Set to "true" only in local dev to allow outbound webhooks to localhost/private IPs.
ORBIX_ALLOW_PRIVATE_WEBHOOKS=false

# ---- Model (OpenAI-compatible). Leave empty to use the deterministic heuristic model (dev only). ----
ORBIX_LLM_BASE_URL=https://api.openai.com/v1
ORBIX_LLM_API_KEY=
ORBIX_LLM_MODEL=gpt-4.1-mini
ORBIX_EMBEDDING_MODEL=text-embedding-3-small
# Per-run hard budget in USD for model calls.
ORBIX_RUN_BUDGET_USD=1.00

# ---- GitHub OAuth app (optional; sandbox works without) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ---- Slack app (optional; sandbox works without) ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ---- Worker ----
ORBIX_WORKER_CONCURRENCY=4
ORBIX_WORKER_POLL_MS=500
ORBIX_TASK_LEASE_MS=60000
