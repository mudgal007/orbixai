{
  "name": "@orbix/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "keys:rotate": "dotenv -e ../../.env -- tsx src/rotate-keys.ts"
  },
  "dependencies": {
    "@orbix/core": "workspace:*",
    "@orbix/db": "workspace:*",
    "@orbix/connectors": "workspace:*",
    "@orbix/engine": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0"
  }
}
