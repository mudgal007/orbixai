{
  "name": "orbix",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --parallel --filter=@orbix/api --filter=@orbix/worker --filter=@orbix/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @orbix/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @orbix/db migrate:dev",
    "db:seed": "pnpm --filter @orbix/worker seed",
    "db:reset": "pnpm --filter @orbix/db reset",
    "db:up": "node tools/dev-db.mjs",
    "keys:rotate": "pnpm --filter @orbix/worker keys:rotate --"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
